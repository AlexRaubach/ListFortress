<div class="container">
<p>
  <p>
  Round Number: <%= @round.round_number %>
  Round Type: <%= @round.roundtype_id.present? ? @round.roundtype&.name : "" %>
  Matches: <%= @matches.size %>
  </p>
</p>
<table  class="table table-striped">
  <thead>
    <tr>
      <th>Player1</th>
      <th>Player1 Points</th>
      <th>Player2</th>
      <th>Player2 Points</th>
      <th>Result</th>
      <th>Winner</th>
      <th> </th>
    </tr>
  </thead>

  <% @matches.each do |match| %>
    <tr>
    <td><%= @participant_names[match.player1_id] %></td>
    <td><%=match.player1_points %></td>
    <td><%= @participant_names[match.player2_id] %></td>
    <td><%=match.player2_points %></td>
    <td><%=match.result %></td>
    <td><%= @participant_names[match.winner_id] %></td>
    <td><%= link_to 'Edit', edit_match_path(match) %></td>

    </tr>
  <% end%>
</table>

<%= link_to 'Edit', edit_round_path(@round) %> |
<%= link_to 'Back', tournament_path(@round.tournament_id) %>
